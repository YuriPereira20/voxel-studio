{
  "_comment": "Single source of VoxelStudio standards. Palette order = palette index (1-based, 0 = empty); append new colors at the end so existing assets keep their indices.",

  "voxel_size_studs": 0.1,
  "bu_per_stud": 1.0,

  "palette": {
    "steel_light":     "EEF4FA",
