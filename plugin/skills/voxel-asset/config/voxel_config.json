    "fire_orange":     "FF7A1A",
    "fire_yellow":     "FFD84A",
    "iron_mid":        "48494E",
    "leather_light":   "9B5236",
    "metal_dark":      "5C5D62",
    "metal_mid":       "8C8D91",
    "metal_light":     "C4C5C8",
    "metal_edge":      "F2F3F5",
    "iron_black":      "2B2B30",
    "bone":            "A9A190",
    "bone_shadow":     "6E6759",
    "blood_red":       "5A1010",
    "cloth_crimson":   "8E1A1A",
    "leather_red":     "5E2219",
    "leather_red_dark":"2E0F0A",
    "glow_red":        "FF0A0A",
    "steel_worn_light":"9C9C97",
    "steel_worn_mid":  "7A7A73",
